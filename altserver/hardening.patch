diff --git a/upstream_repo/AltSign/AppleAPI.cpp b/upstream_repo/AltSign/AppleAPI.cpp
index 331404d..6e89664 100755
--- a/upstream_repo/AltSign/AppleAPI.cpp
+++ b/upstream_repo/AltSign/AppleAPI.cpp
@@ -1022,8 +1022,9 @@ web::http::client::http_client AppleAPI::gsaClient()
 	// reusing the cached _gsaClient member. (This vendored cpprestsdk has no
 	// http_client_config::set_keep_alive(), so a fresh client/connection per
 	// call is how we avoid connection reuse here.)
+	// gsa.apple.com chains to Apple Root CA, which the image adds to the system trust store.
 	http_client_config config;
-	config.set_validate_certificates(false);
+	config.set_validate_certificates(true);
 
 	return web::http::client::http_client(U("https://gsa.apple.com"), config);
 }
