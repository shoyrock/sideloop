root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{py,sh,html,css,js,json,toml,yml,yaml}]
indent_style = space
end_of_line = lf
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{sh,html,css,js,json,yml,yaml}]
indent_size = 2

# Vendor content and native patches must not be rewritten on save.
[.agents/**]
charset = unset
insert_final_newline = unset
end_of_line = unset
trim_trailing_whitespace = false

[altserver/*.patch]
charset = unset
insert_final_newline = unset
end_of_line = unset
trim_trailing_whitespace = false

[.local/**]
charset = unset
insert_final_newline = false
end_of_line = unset
trim_trailing_whitespace = false
